# 复制为 .env 后填写。.env 已在 .gitignore 中。

# 管理员令牌（不填则首次启动随机生成并在日志里打印一次）
ADMIN_TOKEN=

# cpu：用药大拾间账号登录；key：需要访问密钥（在后台生成）；open：任何人可用，按 IP 限额
ACCESS_MODE=key

# 药大拾间集成：与主站 server/.env 里的 NOAI_INTEGRATION_SECRET 相同（至少 32 位）
CPUTIME_SECRET=
PUBLIC_URL=https://noai.cputime.cn

# 供应商密钥：后台可以直接填写，也可以在这里放环境变量、后台填变量名引用（必须以 _KEY 结尾）
# DE_AI_REWRITE_API_KEY=
# DE_AI_REWRITE_BASE_URL=https://your-gateway/v1
# DE_AI_REWRITE_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=

# 允许请求自带供应商（兼容旧版 /api/rewrite {text, apiKey, baseUrl, model}），默认关闭
ALLOW_BYO=0

# 限制
MAX_INPUT_CHARS=20000
RATE_PER_MIN=20
OPEN_DAILY_CHARS=20000
MAX_CONCURRENT=4
MAX_QUEUE=20

# 保存改写正文的小时数，0 表示只保留统计不留原文
STORE_RESULTS_HOURS=0

# 允许跨域调用 API 的来源，逗号分隔
CORS_ORIGINS=
